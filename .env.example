# PostgreSQL — Docker Compose local : port 5433
DATABASE_URL=postgresql://nutrifish:nutrifish@localhost:5433/nutrifish_gmao?schema=public

# Production : DATABASE_URL fourni par le service Postgres
# SEED_DEMO_USERS=0 pour ne pas recréer les comptes démo au démarrage
SEED_DEMO_USERS=1

# Destinataire des rappels préventifs J-1 / Jour J
MAINTENANCE_NOTIFY_EMAIL=maintenance@nutrifish.tn

# Expediteur (domaine vérifié chez Resend / SendGrid / SMTP)
EMAIL_FROM=NutriFish GMAO <maintenance@nutrifish.tn>

# Cron Vercel (optionnel). S'il est défini, Vercel envoie Authorization: Bearer CRON_SECRET
CRON_SECRET=change-me

# --- Un seul fournisseur suffit (priorité : Resend > SendGrid > SMTP) ---
# RESEND_API_KEY=re_xxxxxxxx
# SENDGRID_API_KEY=SG.xxxxxxxx
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=maintenance@nutrifish.tn
# SMTP_PASS=
# SMTP_SECURE=0
# SMTP_URL=smtp://user:pass@smtp.example.com:587
