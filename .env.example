# PostgreSQL — Docker Compose local : port 5433
DATABASE_URL=postgresql://nutrifish:nutrifish@localhost:5433/nutrifish_gmao?schema=public

# Production : DATABASE_URL fourni par le service Postgres
# SEED_DEMO_USERS=0 pour ne pas recréer les comptes démo au démarrage
SEED_DEMO_USERS=1

# Cron Vercel (optionnel). S'il est défini, Vercel envoie Authorization: Bearer CRON_SECRET
CRON_SECRET=change-me

# Les e-mails de rappel (Resend / SMTP) sont désactivés : les notifications restent in-app.
