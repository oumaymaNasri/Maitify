# PostgreSQL — Docker Compose local : port 5433
DATABASE_URL=postgresql://nutrifish:nutrifish@localhost:5433/nutrifish_gmao?schema=public

# Production (Railway / Render) : DATABASE_URL fourni par le service Postgres
# PORT est fourni automatiquement par l'hébergeur
# SEED_DEMO_USERS=0 pour ne pas recréer les comptes démo au démarrage
SEED_DEMO_USERS=1

# Destinataire des rappels préventifs (défaut : maintenance@nutrifish.tn)
MAINTENANCE_NOTIFY_EMAIL=maintenance@nutrifish.tn

# Cron Vercel : Authorization Bearer CRON_SECRET
CRON_SECRET=change-me

# E-mail (au moins un fournisseur) — rappels J-1 / Jour J
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=NutriFish GMAO <noreply@nutrifish.tn>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0
