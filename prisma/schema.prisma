// =============================================================================
// NutriFish GMAO — Schéma relationnel EAM (PostgreSQL)
// Modules : Techniciens/RH · Parc machines · Stock · Interventions · Qualité eau
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ——— Enums RH / Techniciens ———

enum TechnicianRole {
  TECHNICIEN
  RESPONSABLE
}

enum TechnicianSpecialty {
  ELECTRIQUE
  MECANIQUE
  FLUIDES
}

enum TechnicianAvailability {
  DISPONIBLE
  EN_INTERVENTION
}

// ——— Enums parc machines ———

enum MachineAssetStatus {
  OPERATIONAL
  DOWN
  UNDER_MAINTENANCE
}

/// Fréquence / secteur de maintenance préventive (spec usine)
enum MaintenanceFrequency {
  JOURNALIERE
  HEBDOMADAIRE
  MENSUELLE
  PAR_POSTE
}

// ——— Enums interventions (bons de travail) ———

enum OperationType {
  REMPLACEMENT
  DIAGNOSTIC
  AMELIORATION
  CONTROLE
  CHANGEMENT
}

enum FailureCause {
  USURE_NORMALE
  DEFAUT_UTILISATEUR
  DEFAUT_PRODUIT
  AUTRE
  ENTRETIEN_MACHINE
}

enum DurationUnit {
  PER_MINUTE
  MAINTENANCE_DAY
  MASKED_TIME
}

enum MaintenanceWorkflowStatus {
  OPEN
  COMPLETED
}

enum MaintenanceOrderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  ENTREE
  SORTIE
}

/// Compatibilité historique import Access
enum InterventionType {
  CORRECTIVE
  PREVENTIVE
  AMELIORATION
  PREDICTIVE
  AUTONOME
}

// ——— Enums qualité eau ———

enum WaterZone {
  EAU_ADOUC_IE
  BACHE_1
  BACHE_2
  EAU_CHAUDIERE
  RETOUR_CONDENSAT
}

enum DocumentCategory {
  MACHINE_MANUAL
  QUALITY_SHEET
  PHOTO
  SCHEMA
  OTHER
}

enum MaintenanceAttachmentKind {
  PHOTO_BEFORE
  PHOTO_AFTER
  SIGNATURE_IMAGE
  OTHER
}

enum AlertType {
  WATER_QUALITY
  STOCK_LOW
  MAINTENANCE_OVERDUE
  MAINTENANCE_ORDER
  PREVENTIVE_REMINDER
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// ——— Planning préventif (Lot 1) ———

/// Fréquences du moteur de plans (distinct de MaintenanceFrequency / secteur machine).
enum PreventiveFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PreventiveScheduleMode {
  FIXED
  AUTOMATIC
}

enum SundayReschedulePolicy {
  PREV_SATURDAY
  NEXT_MONDAY
  SKIP
}

enum PreventivePlanStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MaintenanceTypeStatus {
  ACTIVE
  INACTIVE
}

enum MaintenanceOccurrenceStatus {
  PLANNED
  GENERATED
  DONE
  OVERDUE
  SKIPPED
  CANCELLED
  RESCHEDULED
}

enum SundayAdjustment {
  NONE
  PREV_SATURDAY
  NEXT_MONDAY
  SKIP
}

enum MaintenanceOrderTaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum MaintenanceOrderTaskSource {
  MANUAL
  PREVENTIVE_PLAN
}

// ——— Auth (optionnel, lien technicien) ———

enum UserRole {
  TECHNICIEN
  RESPONSABLE
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          UserRole  @default(TECHNICIEN)
  passwordHash  String?   @map("password_hash")
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  waterMeasurements WaterQualityMeasurement[] @relation("WaterRecorder")
  technician        Technician?

  preventivePlansCreated   PreventiveMaintenancePlan[] @relation("PreventivePlanCreatedBy")
  preventivePlansUpdated   PreventiveMaintenancePlan[] @relation("PreventivePlanUpdatedBy")
  preventivePlanRevisions  PreventivePlanRevision[]    @relation("PreventivePlanRevisionAuthor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ——— Module 1 : Techniciens & RH ———

model Technician {
  id           String                 @id @default(cuid())
  firstName    String                 @map("first_name")
  lastName     String                 @map("last_name")
  specialty    TechnicianSpecialty
  role         TechnicianRole         @default(TECHNICIEN)
  availability TechnicianAvailability @default(DISPONIBLE)
  email        String?
  phone        String?
  employeeCode String?                @unique @map("employee_code")
  imageUrl     String?                @map("image_url") @db.Text
  userId       String?                @unique
  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  maintenanceLogs              MaintenanceLog[]
  assignedPreventivePlans      PreventiveMaintenancePlan[] @relation("PreventivePlanAssignee")
  assignedMaintenanceOrderTasks MaintenanceOrderTask[]     @relation("OrderTaskAssignee")

  @@index([specialty])
  @@index([availability])
  @@index([role])
}

// ——— Module 2 : Parc machines (assets) ———

model Machine {
  id                 String               @id @default(cuid())
  legacyMatricule    Int?                 @unique
  name               String
  location           String
  maintenanceSector  MaintenanceFrequency @default(HEBDOMADAIRE) @map("maintenance_sector")
  qrCode             String?              @unique
  description        String?              @db.Text
  targetAvailability Float?               @default(0.95)
  galleryImageUrls   String[]             @default([]) @map("galerie_images")
  assetStatus        MachineAssetStatus   @default(OPERATIONAL) @map("asset_status")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  photos          MachinePhoto[]
  manuals         MachineManual[]
  maintenanceLogs       MaintenanceLog[]
  maintenanceOrderLines MaintenanceOrderLine[]
  spareParts            SparePart[]
  partMachines          PartMachine[]
  /// Plans de maintenance préventive (plusieurs plans / machine).
  preventivePlans       PreventiveMaintenancePlan[]

  @@index([assetStatus])
  @@index([location])
  @@index([maintenanceSector])
}

model MachinePhoto {
  id        String   @id @default(cuid())
  machineId String
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
    url       String   @db.Text
  caption   String?
  sortOrder  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([machineId])
}

model MachineManual {
  id        String           @id @default(cuid())
  machineId String
  machine   Machine          @relation(fields: [machineId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  category  DocumentCategory @default(MACHINE_MANUAL)
  createdAt DateTime         @default(now())

  @@index([machineId])
  @@map("MachineDocument")
}

// ——— Module 4 : Maintenance & bons d'intervention ———

model MaintenanceLog {
  id                 String                    @id @default(cuid())
  machineId          String
  machine            Machine                   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  technicianId       String?
  technician         Technician?               @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  date               DateTime
  operationType      OperationType             @default(DIAGNOSTIC) @map("operation_type")
  /// Legacy import Access
  type               InterventionType          @default(CORRECTIVE)
  workflowStatus     MaintenanceWorkflowStatus @default(OPEN) @map("workflow_status")

  failureDescription String?                   @db.Text
  workPerformed      String                    @db.Text
  durationMinutes    Int?
  durationUnit       DurationUnit?             @default(PER_MINUTE) @map("duration_unit")
  downtimeMinutes    Int?                      @map("downtime_minutes")
  failureCause       FailureCause?
  signature          String?                   @db.Text
  importSource       String?
  importMatricule    String? @map("import_matricule")
  linkedFailureCause String? @map("linked_failure_cause") @db.Text
  failureCauseLabel  String? @map("failure_cause_label") @db.Text
  sparePartsLabel    String? @map("spare_parts_label") @db.Text

  sectorMaintenance String?
  service           String?
  operation         String?
  difficulties      String? @db.Text

  preventiveCleaning    Boolean?
  preventiveLubrication Boolean?
  preventiveOil         Boolean?
  preventiveControl     Boolean? @map("preventive_control")
  preventiveNonConforme Boolean? @map("preventive_non_conforme")
  /// Validation terrain : true = réalisée, false = non réalisée, null = pas encore validée
  preventiveRealized    Boolean? @map("preventive_realized")

  maintenanceOrderLineId String?               @unique @map("maintenance_order_line_id")
  maintenanceOrderLine   MaintenanceOrderLine? @relation(fields: [maintenanceOrderLineId], references: [id], onDelete: SetNull)
  maintenanceOrderId     String?               @map("maintenance_order_id")
  maintenanceOrder       MaintenanceOrder?     @relation(fields: [maintenanceOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sparePartUsages SparePartUsage[]
  attachments     MaintenanceAttachment[]
  /// Lien optionnel vers une occurrence préventive (Lot 4 opérationnel).
  preventiveOccurrence MaintenanceOccurrence?

  @@index([machineId])
  @@index([technicianId])
  @@index([date])
  @@index([type])
  @@index([operationType])
  @@index([workflowStatus])
  @@index([machineId, date])
  @@index([machineId, date, type])
  @@index([type, date])
  @@index([type, preventiveRealized])
  @@index([technicianId, date])
  @@index([importMatricule])
  @@index([sectorMaintenance])
  @@index([maintenanceOrderId])
  @@index([maintenanceOrderId, date])
  @@map("Intervention")
}

// ——— Ordres de maintenance (planification Directeur) ———

model MaintenanceOrder {
  id                 String                   @id @default(cuid())
  reference          String                   @unique
  plannedDate        DateTime                 @map("planned_date")
  /// Jour calendaire Africa/Tunis (YYYY-MM-DD) — un OM unique par journée.
  dayKey             String?                  @unique @map("day_key")
  autoGenerated      Boolean                  @default(false) @map("auto_generated")
  status             MaintenanceOrderStatus   @default(ACTIVE)
  observationComment String?                  @map("observation_comment") @db.Text
  managerApproval    String?                  @map("manager_approval") @db.Text
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  lines        MaintenanceOrderLine[]
  logs         MaintenanceLog[]
  /// Occurrences préventives rattachées à cet OM journalier (Lot 4).
  occurrences  MaintenanceOccurrence[]

  @@index([plannedDate])
  @@index([plannedDate, status])
  @@index([status])
  @@map("MaintenanceOrder")
}

model MaintenanceOrderLine {
  id                 String           @id @default(cuid())
  maintenanceOrderId String           @map("maintenance_order_id")
  maintenanceOrder   MaintenanceOrder @relation(fields: [maintenanceOrderId], references: [id], onDelete: Cascade)
  machineId          String           @map("machine_id")
  machine            Machine          @relation(fields: [machineId], references: [id], onDelete: Restrict)
  taskNettoyage      Boolean          @default(false) @map("task_nettoyage")
  taskGraissage      Boolean          @default(false) @map("task_graissage")
  taskHuile          Boolean          @default(false) @map("task_huile")
  taskControl        Boolean          @default(false) @map("task_control")
  taskControle       Boolean          @default(false) @map("task_controle")
  taskNonConforme    Boolean          @default(false) @map("task_non_conforme")
  maintenanceLog     MaintenanceLog?
  /// Tâches multi-plans sous la ligne machine (unicité ligne conservée).
  tasks              MaintenanceOrderTask[]

  @@unique([maintenanceOrderId, machineId])
  @@index([machineId])
  @@index([maintenanceOrderId])
  @@map("MaintenanceOrderLine")
}

/// Tâche préventive (ou manuelle) rattachée à une ligne OM machine — prépare le multi-plans / jour.
model MaintenanceOrderTask {
  id                     String                     @id @default(cuid())
  maintenanceOrderLineId String                     @map("maintenance_order_line_id")
  maintenanceOrderLine   MaintenanceOrderLine       @relation(fields: [maintenanceOrderLineId], references: [id], onDelete: Cascade)
  maintenanceTypeId      String?                    @map("maintenance_type_id")
  maintenanceType        MaintenanceType?           @relation(fields: [maintenanceTypeId], references: [id], onDelete: SetNull)
  title                  String
  instructions           String?                    @db.Text
  plannedTime            String?                    @map("planned_time")
  estimatedDurationMin   Int?                       @map("estimated_duration_min")
  assigneeTechnicianId   String?                    @map("assignee_technician_id")
  assignee               Technician?                @relation("OrderTaskAssignee", fields: [assigneeTechnicianId], references: [id], onDelete: SetNull)
  status                 MaintenanceOrderTaskStatus @default(OPEN)
  source                 MaintenanceOrderTaskSource @default(MANUAL)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  occurrence MaintenanceOccurrence?

  @@index([maintenanceOrderLineId])
  @@index([maintenanceTypeId])
  @@index([assigneeTechnicianId])
  @@index([status])
  @@map("MaintenanceOrderTask")
}

model MaintenanceAttachment {
  id               String                    @id @default(cuid())
  maintenanceLogId String
  maintenanceLog     MaintenanceLog            @relation(fields: [maintenanceLogId], references: [id], onDelete: Cascade)
  kind             MaintenanceAttachmentKind
  url              String
  createdAt        DateTime                  @default(now())

  @@index([maintenanceLogId])
}

// ——— Module 3 : Stock & pièces (SparePart + PartUsage) ———

model SparePart {
  id          String   @id @default(cuid())
  designation String
  brand       String?
  reference   String?
  imageUrl    String?
  quantity    Int      @default(0)
  minStock    Int      @default(0) @map("min_stock")
  machineId   String?
  machine     Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usages         SparePartUsage[]
  stockMovements StockMovement[]
  partMachines   PartMachine[]

  @@index([reference])
  @@index([designation])
  @@index([quantity])
  @@index([machineId])
  @@map("Part")
}

model PartMachine {
  partId    String    @map("part_id")
  machineId String    @map("machine_id")
  part      SparePart @relation(fields: [partId], references: [id], onDelete: Cascade)
  machine   Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@id([partId, machineId])
  @@index([machineId])
  @@map("PartMachine")
}

model StockMovement {
  id        String            @id @default(cuid())
  partId    String            @map("part_id")
  part      SparePart         @relation(fields: [partId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Int
  date      DateTime          @default(now())
  motif     String?           @db.Text
  createdAt DateTime          @default(now())

  @@index([partId, date])
  @@index([date])
  @@map("StockMovement")
}

model SparePartUsage {
  id               String         @id @default(cuid())
  maintenanceLogId String         @map("intervention_id")
  maintenanceLog   MaintenanceLog @relation(fields: [maintenanceLogId], references: [id], onDelete: Cascade)
  sparePartId      String         @map("part_id")
  sparePart        SparePart      @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  quantityUsed     Int            @default(1) @map("quantity_used")

  @@unique([maintenanceLogId, sparePartId])
  @@index([maintenanceLogId])
  @@index([sparePartId])
  @@map("InterventionPart")
}

// ——— Qualité eau & alertes ———

model WaterQualityMeasurement {
  id           String    @id @default(cuid())
  zone         WaterZone
  measuredAt   DateTime  @default(now())
  ph           Float?
  th           Float?
  conductivity Float?
  ta           Float?
  tac          Float?
  cl           Float?
  notes        String?   @db.Text
  recordedById String?
  recorder     User?     @relation("WaterRecorder", fields: [recordedById], references: [id])

  @@index([zone, measuredAt])
  @@index([measuredAt])
}

model WaterQualityThreshold {
  zone            WaterZone @id
  phMin           Float?
  phMax           Float?
  thMin           Float?
  thMax           Float?
  taMin           Float?
  taMax           Float?
  tacMin          Float?
  tacMax          Float?
  clMin           Float?
  clMax           Float?
  conductivityMin Float?
  conductivityMax Float?
  updatedAt       DateTime  @updatedAt
}

model GmaoAlert {
  id         String        @id @default(cuid())
  type       AlertType
  severity   AlertSeverity
  title      String
  message    String        @db.Text
  metadata   Json?
  /// Clé d’idempotence (ex. rappel J-1 / Jour J d’un OM).
  dedupeKey  String?       @unique @map("dedupe_key")
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([resolvedAt, createdAt])
  @@index([type, resolvedAt])
}

// =============================================================================
// Module Planning préventif — Lot 1 (référentiel + modèle)
// Fuseau métier : Africa/Tunis. Aucune donnée legacy migrée automatiquement.
// =============================================================================

/// Catalogue configurable des types de maintenance (distinct de InterventionType / OperationType).
model MaintenanceType {
  id                  String                @id @default(cuid())
  code                String                @unique
  label               String
  description         String?               @db.Text
  defaultInstructions String?               @map("default_instructions") @db.Text
  defaultDurationMin  Int?                  @map("default_duration_min")
  requiredSpecialty   TechnicianSpecialty?  @map("required_specialty")
  status              MaintenanceTypeStatus @default(ACTIVE)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  plans PreventiveMaintenancePlan[]
  tasks MaintenanceOrderTask[]

  @@index([status])
  @@index([label])
  @@map("MaintenanceType")
}

/// Plan de maintenance préventive rattaché à une machine (plusieurs plans / machine).
model PreventiveMaintenancePlan {
  id                     String                   @id @default(cuid())
  machineId              String                   @map("machine_id")
  machine                Machine                  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  maintenanceTypeId      String                   @map("maintenance_type_id")
  maintenanceType        MaintenanceType          @relation(fields: [maintenanceTypeId], references: [id], onDelete: Restrict)
  title                  String
  description            String?                  @db.Text
  instructions           String?                  @db.Text
  frequency              PreventiveFrequency
  /// Nombre d'exécutions par période (ex. 2 / jour, 3 / semaine).
  occurrencesPerPeriod   Int                      @map("occurrences_per_period")
  scheduleMode           PreventiveScheduleMode   @map("schedule_mode")
  includeSunday          Boolean                  @default(false) @map("include_sunday")
  sundayPolicy           SundayReschedulePolicy   @default(NEXT_MONDAY) @map("sunday_policy")
  startDate              DateTime                 @map("start_date") @db.Date
  endDate                DateTime?                @map("end_date") @db.Date
  estimatedDurationMin   Int?                     @map("estimated_duration_min")
  assigneeTechnicianId   String?                  @map("assignee_technician_id")
  assignee               Technician?              @relation("PreventivePlanAssignee", fields: [assigneeTechnicianId], references: [id], onDelete: SetNull)
  status                 PreventivePlanStatus     @default(ACTIVE)
  version                Int                      @default(1)
  /// Fuseau de calcul des échéances (métier NutriFish).
  timezone               String                   @default("Africa/Tunis")
  /// Horaires par défaut (mode AUTOMATIC), format HH:mm.
  defaultTimes           String[]                 @default([]) @map("default_times")
  generationHorizonDays  Int                      @default(30) @map("generation_horizon_days")
  lastGeneratedAt        DateTime?                @map("last_generated_at")
  createdByUserId        String?                  @map("created_by_user_id")
  createdBy              User?                    @relation("PreventivePlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId        String?                  @map("updated_by_user_id")
  updatedBy              User?                    @relation("PreventivePlanUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  scheduleRules MaintenanceScheduleRule[]
  occurrences   MaintenanceOccurrence[]
  revisions     PreventivePlanRevision[]

  @@index([machineId, status])
  @@index([maintenanceTypeId])
  @@index([status])
  @@index([frequency])
  @@index([assigneeTechnicianId])
  @@map("PreventiveMaintenancePlan")
}

/// Créneaux / slots du mode FIXED (et paramètres de position pour la période).
model MaintenanceScheduleRule {
  id        String                    @id @default(cuid())
  planId    String                    @map("plan_id")
  plan      PreventiveMaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Rang 0..N-1 dans la période (= occurrenceIndex).
  sortOrder Int                       @map("sort_order")
  /// 1 = lundi … 7 = dimanche (ISO-like).
  weekday   Int?
  /// Jour du mois 1..31 (MONTHLY / YEARLY).
  monthDay  Int?                      @map("month_day")
  /// Mois 1..12 (YEARLY).
  month     Int?
  /// Heure locale Africa/Tunis, format HH:mm.
  timeLocal String                    @map("time_local")
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@unique([planId, sortOrder])
  @@index([planId])
  @@map("MaintenanceScheduleRule")
}

/// Occurrence calculée / générée — conserve date théorique et date planifiée.
model MaintenanceOccurrence {
  id                     String                      @id @default(cuid())
  planId                 String                      @map("plan_id")
  plan                   PreventiveMaintenancePlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Version du plan au moment du calcul / génération.
  planVersion            Int                         @map("plan_version")
  /// Clé d'idempotence : planId|periodKey|occurrenceIndex|theoreticalDate|theoreticalTime
  occurrenceKey          String                      @unique @map("occurrence_key")
  /// Ex. 2026-11-15 | 2026-W46 | 2026-11 | 2026
  periodKey              String                      @map("period_key")
  occurrenceIndex        Int                         @map("occurrence_index")
  theoreticalDate        DateTime                    @map("theoretical_date") @db.Date
  theoreticalTime        String                      @map("theoretical_time")
  /// Null si sundayPolicy = SKIP.
  plannedDate            DateTime?                   @map("planned_date") @db.Date
  plannedTime            String?                     @map("planned_time")
  plannedAtUtc           DateTime?                   @map("planned_at_utc")
  sundayAdjustment       SundayAdjustment            @default(NONE) @map("sunday_adjustment")
  status                 MaintenanceOccurrenceStatus @default(PLANNED)
  maintenanceOrderId     String?                     @map("maintenance_order_id")
  maintenanceOrder       MaintenanceOrder?           @relation(fields: [maintenanceOrderId], references: [id], onDelete: SetNull)
  maintenanceOrderTaskId String?                     @unique @map("maintenance_order_task_id")
  maintenanceOrderTask   MaintenanceOrderTask?       @relation(fields: [maintenanceOrderTaskId], references: [id], onDelete: SetNull)
  maintenanceLogId       String?                     @unique @map("maintenance_log_id")
  maintenanceLog         MaintenanceLog?             @relation(fields: [maintenanceLogId], references: [id], onDelete: SetNull)
  completedAt            DateTime?                   @map("completed_at")
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([planId, plannedDate])
  @@index([status, plannedDate])
  @@index([maintenanceOrderId])
  @@index([theoreticalDate])
  @@index([periodKey])
  @@map("MaintenanceOccurrence")
}

/// Historique versionné des modifications de plan (snapshot JSON).
model PreventivePlanRevision {
  id              String                    @id @default(cuid())
  planId          String                    @map("plan_id")
  plan            PreventiveMaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  version         Int
  snapshot        Json
  changeSummary   String?                   @map("change_summary") @db.Text
  changedByUserId String?                   @map("changed_by_user_id")
  changedBy       User?                     @relation("PreventivePlanRevisionAuthor", fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedAt       DateTime                  @default(now()) @map("changed_at")

  @@unique([planId, version])
  @@index([planId, changedAt])
  @@index([changedByUserId])
  @@map("PreventivePlanRevision")
}
